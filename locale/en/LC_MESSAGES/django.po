msgstr "executed"

#: enjambre/templates/enjambre/bitacora.html:74
msgid "pendiente"
msgstr "pending"

#: enjambre/templates/enjambre/bitacora.html:75
#: enjambre/templates/enjambre/bitacora.html:109
